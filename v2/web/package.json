{
  "name": "@surveyscan/web",
  "version": "0.1.0-c09",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "generate": "openapi-typescript ../contracts/openapi.json -o src/generated/c03.ts && openapi-typescript ../contracts/c09.openapi.json -o src/generated/c09.ts && node scripts/validators.mjs",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build && node scripts/manifest.mjs",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
