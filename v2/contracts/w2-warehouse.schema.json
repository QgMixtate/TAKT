{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:surveyscan:w2:warehouse:1:0",
 "title": "Склад и жизненный цикл оборудования (волна 2; decisions/C41-w2-scope-and-model.md)",
 "$defs": {
  "Location": {
   "type": "object",
   "properties": {
    "location_id": {
     "type": "string",
     "format": "uuid"
    },
    "site_id": {
     "type": "string",
     "format": "uuid"
    },
    "parent_id": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "kind": {
     "enum": [
      "warehouse",
      "bin",
      "repair"
     ]
    },
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 128
    },
    "active": {
     "type": "boolean"
    }
   },
   "required": [
    "location_id",
    "site_id",
    "parent_id",
    "kind",
    "name",
    "active"
   ],
   "additionalProperties": false
  },
  "Item": {
   "type": "object",
   "properties": {
    "item_id": {
     "type": "string",
     "format": "uuid"
    },
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 256
    },
    "kind": {
     "enum": [
      "serial",
      "quantity"
     ]
    },
    "unit": {
     "type": "string",
     "minLength": 1,
     "maxLength": 16
    },
    "category": {
     "oneOf": [
      {
       "type": "string",
       "maxLength": 64
      },
      {
       "type": "null"
      }
     ]
    },
    "active": {
     "type": "boolean"
    },
    "compatible_models": {
     "type": "array",
     "maxItems": 100,
     "items": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128
     }
    }
   },
   "required": [
    "item_id",
    "name",
    "kind",
    "unit",
    "category",
    "active",
    "compatible_models"
   ],
   "additionalProperties": false
  },
  "Unit": {
   "type": "object",
   "properties": {
    "unit_id": {
     "type": "string",
     "format": "uuid"
    },
    "item_id": {
     "type": "string",
     "format": "uuid"
    },
    "item_name": {
     "type": "string"
    },
    "serial": {
     "type": "string",
     "minLength": 1,
     "maxLength": 128
    },
    "inventory_no": {
     "oneOf": [
      {
       "type": "string",
       "maxLength": 64
      },
      {
       "type": "null"
      }
     ]
    },
    "asset_uid": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "state": {
     "enum": [
      "in_stock",
      "reserved",
      "issued",
      "installed",
      "in_repair",
      "written_off",
      "lost"
     ]
    },
    "location_id": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "holder_id": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "installed_on": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "installed_name": {
     "type": "string",
     "maxLength": 256,
     "description": "имя актива, на котором установлен экземпляр (для отображения); пусто — имя неизвестно"
    }
   },
   "required": [
    "unit_id",
    "item_id",
    "item_name",
    "serial",
    "inventory_no",
    "asset_uid",
    "state",
    "location_id",
    "holder_id",
    "installed_on"
   ],
   "additionalProperties": false
  },
  "StockRow": {
   "type": "object",
   "properties": {
    "item_id": {
     "type": "string",
     "format": "uuid"
    },
    "item_name": {
     "type": "string"
    },
    "unit": {
     "type": "string"
    },
    "location_id": {
     "type": "string",
     "format": "uuid"
    },
    "quantity": {
     "type": "number",
     "minimum": 0
    },
    "reserved": {
     "type": "number",
     "minimum": 0
    }
   },
   "required": [
    "item_id",
    "item_name",
    "unit",
    "location_id",
    "quantity",
    "reserved"
   ],
   "additionalProperties": false
  },
  "MovementLine": {
   "type": "object",
   "properties": {
    "line_no": {
     "type": "integer",
     "minimum": 1
    },
    "item_id": {
     "type": "string",
     "format": "uuid"
    },
    "item_name": {
     "type": "string"
    },
    "unit": {
     "type": "string"
    },
    "unit_id": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "serial": {
     "oneOf": [
      {
       "type": "string",
       "maxLength": 128
      },
      {
       "type": "null"
      }
     ]
    },
    "inventory_no": {
     "oneOf": [
      {
       "type": "string",
       "maxLength": 64
      },
      {
       "type": "null"
      }
     ]
    },
    "quantity": {
     "type": "number",
     "exclusiveMinimum": 0
    }
   },
   "required": [
    "line_no",
    "item_id",
    "item_name",
    "unit",
    "unit_id",
    "serial",
    "inventory_no",
    "quantity"
   ],
   "additionalProperties": false
  },
  "Movement": {
   "description": "Движение (запись журнала) и данные акта; в списке журнала lines = null",
   "type": "object",
   "properties": {
    "movement_id": {
     "type": "string",
     "format": "uuid"
    },
    "kind": {
     "enum": [
      "receive",
      "issue",
      "return",
      "transfer",
      "repair_out",
      "repair_in",
      "install",
      "remove",
      "write_off",
      "adjust",
      "reverse"
     ]
    },
    "act_no": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{6}$"
    },
    "occurred_at": {
     "type": "string",
     "format": "date-time"
    },
    "actor_ref": {
     "type": "string"
    },
    "basis": {
     "type": "string",
     "minLength": 1,
     "maxLength": 256
    },
    "note": {
     "oneOf": [
      {
       "type": "string",
       "maxLength": 1024
      },
      {
       "type": "null"
      }
     ]
    },
    "from_location": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "to_location": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "from_holder": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "to_holder": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "asset_uid": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "reverses": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "lines": {
     "oneOf": [
      {
       "type": "array",
       "items": {
        "$ref": "#/$defs/MovementLine"
       }
      },
      {
       "type": "null"
      }
     ]
    },
    "actor_name": {
     "oneOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "compat_override": {
     "type": "boolean"
    }
   },
   "required": [
    "movement_id",
    "kind",
    "act_no",
    "occurred_at",
    "actor_ref",
    "actor_name",
    "basis",
    "note",
    "from_location",
    "to_location",
    "from_holder",
    "to_holder",
    "asset_uid",
    "reverses",
    "compat_override",
    "lines"
   ],
   "additionalProperties": false
  },
  "Discrepancy": {
   "type": "object",
   "properties": {
    "item_id": {
     "type": "string",
     "format": "uuid"
    },
    "location_id": {
     "type": "string",
     "format": "uuid"
    },
    "stock": {
     "type": "number"
    },
    "journal": {
     "type": "number"
    }
   },
   "required": [
    "item_id",
    "location_id",
    "stock",
    "journal"
   ],
   "additionalProperties": false
  },
  "LocationList": {
   "type": "object",
   "properties": {
    "items": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Location"
     }
    }
   },
   "required": [
    "items"
   ],
   "additionalProperties": false
  },
  "ItemList": {
   "type": "object",
   "properties": {
    "items": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Item"
     }
    }
   },
   "required": [
    "items"
   ],
   "additionalProperties": false
  },
  "UnitList": {
   "type": "object",
   "properties": {
    "items": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Unit"
     }
    }
   },
   "required": [
    "items"
   ],
   "additionalProperties": false
  },
  "StockList": {
   "type": "object",
   "properties": {
    "items": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/StockRow"
     }
    }
   },
   "required": [
    "items"
   ],
   "additionalProperties": false
  },
  "MovementList": {
   "type": "object",
   "properties": {
    "items": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Movement"
     }
    }
   },
   "required": [
    "items"
   ],
   "additionalProperties": false
  },
  "StockVerification": {
   "type": "object",
   "properties": {
    "discrepancies": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Discrepancy"
     }
    }
   },
   "required": [
    "discrepancies"
   ],
   "additionalProperties": false
  },
  "Reservation": {
   "type": "object",
   "properties": {
    "reservation_id": {
     "type": "string",
     "format": "uuid"
    },
    "unit_id": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "item_id": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "location_id": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "quantity": {
     "oneOf": [
      {
       "type": "number",
       "exclusiveMinimum": 0
      },
      {
       "type": "null"
      }
     ]
    },
    "holder_id": {
     "type": "string",
     "format": "uuid"
    },
    "basis": {
     "type": "string",
     "minLength": 1,
     "maxLength": 256
    },
    "expires_at": {
     "type": "string",
     "format": "date-time"
    },
    "state": {
     "enum": [
      "active",
      "fulfilled",
      "cancelled",
      "expired"
     ]
    },
    "created_by": {
     "type": "string"
    },
    "created_at": {
     "type": "string",
     "format": "date-time"
    },
    "label": {
     "type": "string"
    }
   },
   "additionalProperties": false,
   "required": [
    "reservation_id",
    "unit_id",
    "item_id",
    "location_id",
    "quantity",
    "holder_id",
    "basis",
    "expires_at",
    "state",
    "created_by",
    "created_at",
    "label"
   ]
  },
  "ReservationList": {
   "type": "object",
   "properties": {
    "items": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Reservation"
     }
    }
   },
   "required": [
    "items"
   ],
   "additionalProperties": false
  },
  "Inventory": {
   "type": "object",
   "properties": {
    "inventory_id": {
     "type": "string",
     "format": "uuid"
    },
    "location_id": {
     "type": "string",
     "format": "uuid"
    },
    "act_no": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{6}$"
    },
    "basis": {
     "type": "string",
     "minLength": 1,
     "maxLength": 256
    },
    "state": {
     "enum": [
      "open",
      "closed",
      "cancelled"
     ]
    },
    "started_at": {
     "type": "string",
     "format": "date-time"
    },
    "started_by": {
     "type": "string"
    },
    "closed_at": {
     "oneOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ]
    },
    "shortage_movement": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "surplus_movement": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "inventory_id",
    "location_id",
    "act_no",
    "basis",
    "state",
    "started_at",
    "started_by",
    "closed_at",
    "shortage_movement",
    "surplus_movement"
   ],
   "additionalProperties": false
  },
  "InventoryLine": {
   "type": "object",
   "properties": {
    "item_id": {
     "type": "string",
     "format": "uuid"
    },
    "item_name": {
     "type": "string"
    },
    "unit": {
     "type": "string"
    },
    "unit_id": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "serial": {
     "oneOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "expected": {
     "type": "number",
     "minimum": 0
    },
    "counted": {
     "oneOf": [
      {
       "type": "number",
       "minimum": 0
      },
      {
       "type": "null"
      }
     ]
    },
    "result": {
     "enum": [
      "ok",
      "shortage",
      "surplus",
      "elsewhere"
     ]
    },
    "where": {
     "oneOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "item_id",
    "item_name",
    "unit",
    "unit_id",
    "serial",
    "expected",
    "counted",
    "result",
    "where"
   ],
   "additionalProperties": false
  },
  "InventoryDetail": {
   "type": "object",
   "properties": {
    "inventory_id": {
     "type": "string",
     "format": "uuid"
    },
    "location_id": {
     "type": "string",
     "format": "uuid"
    },
    "act_no": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{6}$"
    },
    "basis": {
     "type": "string",
     "minLength": 1,
     "maxLength": 256
    },
    "state": {
     "enum": [
      "open",
      "closed",
      "cancelled"
     ]
    },
    "started_at": {
     "type": "string",
     "format": "date-time"
    },
    "started_by": {
     "type": "string"
    },
    "closed_at": {
     "oneOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ]
    },
    "shortage_movement": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "surplus_movement": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "lines": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/InventoryLine"
     }
    }
   },
   "required": [
    "inventory_id",
    "location_id",
    "act_no",
    "basis",
    "state",
    "started_at",
    "started_by",
    "closed_at",
    "shortage_movement",
    "surplus_movement",
    "lines"
   ],
   "additionalProperties": false
  },
  "InventoryList": {
   "type": "object",
   "properties": {
    "items": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Inventory"
     }
    }
   },
   "required": [
    "items"
   ],
   "additionalProperties": false
  },
  "Compatibility": {
   "type": "object",
   "properties": {
    "compatible": {
     "oneOf": [
      {
       "type": "boolean"
      },
      {
       "type": "null"
      }
     ]
    },
    "asset_model": {
     "type": "string"
    }
   },
   "required": [
    "compatible",
    "asset_model"
   ],
   "additionalProperties": false
  }
 }
}
