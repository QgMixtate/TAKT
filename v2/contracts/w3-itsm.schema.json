{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:surveyscan:w3:itsm:1:0",
 "title": "Обращения ITSM (волна 3; decisions/C46-w3-itsm-scope-and-model.md)",
 "$defs": {
  "Ticket": {
   "type": "object",
   "properties": {
    "ticket_id": {
     "type": "string",
     "format": "uuid"
    },
    "kind": {
     "enum": [
      "incident",
      "request",
      "change",
      "problem"
     ]
    },
    "number": {
     "type": "string",
     "pattern": "^(INC|REQ|CHG|PRB)-[0-9]{4}-[0-9]{6}$"
    },
    "title": {
     "type": "string",
     "minLength": 1,
     "maxLength": 256
    },
    "description": {
     "type": "string",
     "maxLength": 8000
    },
    "impact": {
     "type": "integer",
     "minimum": 1,
     "maximum": 3
    },
    "urgency": {
     "type": "integer",
     "minimum": 1,
     "maximum": 3
    },
    "priority": {
     "type": "integer",
     "minimum": 1,
     "maximum": 4
    },
    "state": {
     "enum": [
      "new",
      "assigned",
      "in_progress",
      "waiting_customer",
      "resolved",
      "closed",
      "cancelled",
      "investigating",
      "known_error",
      "submitted",
      "pending_approval",
      "approved",
      "rejected",
      "in_fulfillment",
      "fulfilled",
      "draft",
      "scheduled",
      "completed",
      "rolled_back"
     ]
    },
    "requester_id": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "assignee_id": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "team_id": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "resolution": {
     "oneOf": [
      {
       "type": "string",
       "maxLength": 4000
      },
      {
       "type": "null"
      }
     ]
    },
    "workaround": {
     "oneOf": [
      {
       "type": "string",
       "maxLength": 4000
      },
      {
       "type": "null"
      }
     ]
    },
    "reopen_count": {
     "type": "integer",
     "minimum": 0
    },
    "created_by": {
     "type": "string"
    },
    "created_at": {
     "type": "string",
     "format": "date-time"
    },
    "updated_at": {
     "type": "string",
     "format": "date-time"
    },
    "resolved_at": {
     "oneOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ]
    },
    "closed_at": {
     "oneOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ]
    },
    "revision": {
     "type": "string",
     "pattern": "^[0-9]+$"
    }
   },
   "required": [
    "ticket_id",
    "kind",
    "number",
    "title",
    "description",
    "impact",
    "urgency",
    "priority",
    "state",
    "requester_id",
    "assignee_id",
    "team_id",
    "resolution",
    "workaround",
    "reopen_count",
    "created_by",
    "created_at",
    "updated_at",
    "resolved_at",
    "closed_at",
    "revision"
   ],
   "additionalProperties": false
  },
  "Link": {
   "type": "object",
   "properties": {
    "target_kind": {
     "enum": [
      "asset",
      "service",
      "ticket",
      "movement"
     ]
    },
    "target_id": {
     "type": "string",
     "format": "uuid"
    },
    "label": {
     "type": "string"
    }
   },
   "required": [
    "target_kind",
    "target_id",
    "label"
   ],
   "additionalProperties": false
  },
  "Event": {
   "type": "object",
   "properties": {
    "event_id": {
     "type": "string",
     "format": "uuid"
    },
    "kind": {
     "enum": [
      "created",
      "state",
      "assigned",
      "comment",
      "linked",
      "priority",
      "approval",
      "fulfilled"
     ]
    },
    "public": {
     "type": "boolean"
    },
    "detail": {
     "type": "object"
    },
    "text": {
     "oneOf": [
      {
       "type": "string",
       "maxLength": 8000
      },
      {
       "type": "null"
      }
     ]
    },
    "actor_ref": {
     "type": "string"
    },
    "occurred_at": {
     "type": "string",
     "format": "date-time"
    }
   },
   "required": [
    "event_id",
    "kind",
    "public",
    "detail",
    "text",
    "actor_ref",
    "occurred_at"
   ],
   "additionalProperties": false
  },
  "TicketDetail": {
   "type": "object",
   "properties": {
    "ticket_id": {
     "type": "string",
     "format": "uuid"
    },
    "kind": {
     "enum": [
      "incident",
      "request",
      "change",
      "problem"
     ]
    },
    "number": {
     "type": "string",
     "pattern": "^(INC|REQ|CHG|PRB)-[0-9]{4}-[0-9]{6}$"
    },
    "title": {
     "type": "string",
     "minLength": 1,
     "maxLength": 256
    },
    "description": {
     "type": "string",
     "maxLength": 8000
    },
    "impact": {
     "type": "integer",
     "minimum": 1,
     "maximum": 3
    },
    "urgency": {
     "type": "integer",
     "minimum": 1,
     "maximum": 3
    },
    "priority": {
     "type": "integer",
     "minimum": 1,
     "maximum": 4
    },
    "state": {
     "enum": [
      "new",
      "assigned",
      "in_progress",
      "waiting_customer",
      "resolved",
      "closed",
      "cancelled",
      "investigating",
      "known_error",
      "submitted",
      "pending_approval",
      "approved",
      "rejected",
      "in_fulfillment",
      "fulfilled",
      "draft",
      "scheduled",
      "completed",
      "rolled_back"
     ]
    },
    "requester_id": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "assignee_id": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "team_id": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "resolution": {
     "oneOf": [
      {
       "type": "string",
       "maxLength": 4000
      },
      {
       "type": "null"
      }
     ]
    },
    "workaround": {
     "oneOf": [
      {
       "type": "string",
       "maxLength": 4000
      },
      {
       "type": "null"
      }
     ]
    },
    "reopen_count": {
     "type": "integer",
     "minimum": 0
    },
    "created_by": {
     "type": "string"
    },
    "created_at": {
     "type": "string",
     "format": "date-time"
    },
    "updated_at": {
     "type": "string",
     "format": "date-time"
    },
    "resolved_at": {
     "oneOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ]
    },
    "closed_at": {
     "oneOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ]
    },
    "revision": {
     "type": "string",
     "pattern": "^[0-9]+$"
    },
    "allowed_transitions": {
     "type": "array",
     "items": {
      "enum": [
       "new",
       "assigned",
       "in_progress",
       "waiting_customer",
       "resolved",
       "closed",
       "cancelled",
       "investigating",
       "known_error",
       "submitted",
       "pending_approval",
       "approved",
       "rejected",
       "in_fulfillment",
       "fulfilled",
       "draft",
       "scheduled",
       "completed",
       "rolled_back"
      ]
     }
    },
    "links": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Link"
     }
    },
    "events": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Event"
     }
    },
    "workarounds": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "request": {
     "oneOf": [
      {
       "$ref": "#/$defs/Request"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "ticket_id",
    "kind",
    "number",
    "title",
    "description",
    "impact",
    "urgency",
    "priority",
    "state",
    "requester_id",
    "assignee_id",
    "team_id",
    "resolution",
    "workaround",
    "reopen_count",
    "created_by",
    "created_at",
    "updated_at",
    "resolved_at",
    "closed_at",
    "revision",
    "allowed_transitions",
    "links",
    "events",
    "workarounds",
    "request"
   ],
   "additionalProperties": false
  },
  "TicketList": {
   "type": "object",
   "properties": {
    "items": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Ticket"
     }
    }
   },
   "required": [
    "items"
   ],
   "additionalProperties": false
  },
  "PortalSession": {
   "description": "POST /api/v1/auth/directory-sessions — сессия заявителя (вход по AD); C03 Session не меняется",
   "type": "object",
   "properties": {
    "user_id": {
     "type": "string",
     "format": "uuid"
    },
    "tenant_id": {
     "type": "string",
     "format": "uuid"
    },
    "roles": {
     "type": "array",
     "items": {
      "const": "requester"
     },
     "minItems": 1,
     "maxItems": 1
    },
    "expires_at": {
     "type": "string",
     "format": "date-time"
    },
    "csrf_token": {
     "type": "string",
     "minLength": 1,
     "maxLength": 256
    }
   },
   "required": [
    "user_id",
    "tenant_id",
    "roles",
    "expires_at",
    "csrf_token"
   ],
   "additionalProperties": false
  },
  "Field": {
   "type": "object",
   "properties": {
    "key": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    "label": {
     "type": "string",
     "minLength": 1,
     "maxLength": 128
    },
    "type": {
     "enum": [
      "text",
      "textarea",
      "select"
     ]
    },
    "required": {
     "type": "boolean"
    },
    "options": {
     "type": "array",
     "maxItems": 50,
     "items": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
     }
    }
   },
   "required": [
    "key",
    "label",
    "type",
    "required",
    "options"
   ],
   "additionalProperties": false
  },
  "CatalogItem": {
   "type": "object",
   "properties": {
    "item_id": {
     "type": "string",
     "format": "uuid"
    },
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 128
    },
    "description": {
     "type": "string",
     "maxLength": 4000
    },
    "form": {
     "type": "array",
     "maxItems": 20,
     "items": {
      "$ref": "#/$defs/Field"
     }
    },
    "approver_id": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "team_id": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "warehouse_item_id": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "active": {
     "type": "boolean"
    },
    "revision": {
     "type": "string",
     "pattern": "^[0-9]+$"
    }
   },
   "required": [
    "item_id",
    "name",
    "description",
    "form",
    "approver_id",
    "team_id",
    "warehouse_item_id",
    "active",
    "revision"
   ],
   "additionalProperties": false
  },
  "CatalogList": {
   "type": "object",
   "properties": {
    "items": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/CatalogItem"
     }
    }
   },
   "required": [
    "items"
   ],
   "additionalProperties": false
  },
  "Approval": {
   "type": "object",
   "properties": {
    "approver_id": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "decision": {
     "enum": [
      "approved",
      "rejected"
     ]
    },
    "comment": {
     "oneOf": [
      {
       "type": "string",
       "maxLength": 2000
      },
      {
       "type": "null"
      }
     ]
    },
    "decided_by": {
     "type": "string"
    },
    "decided_at": {
     "type": "string",
     "format": "date-time"
    }
   },
   "required": [
    "approver_id",
    "decision",
    "comment",
    "decided_by",
    "decided_at"
   ],
   "additionalProperties": false
  },
  "Request": {
   "type": "object",
   "properties": {
    "catalog_item_id": {
     "type": "string",
     "format": "uuid"
    },
    "catalog_name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 128
    },
    "form_values": {
     "type": "object",
     "additionalProperties": {
      "type": "string",
      "maxLength": 1000
     }
    },
    "approver_id": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "warehouse_item_id": {
     "oneOf": [
      {
       "type": "string",
       "format": "uuid"
      },
      {
       "type": "null"
      }
     ]
    },
    "approval": {
     "oneOf": [
      {
       "$ref": "#/$defs/Approval"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "catalog_item_id",
    "catalog_name",
    "form_values",
    "approver_id",
    "warehouse_item_id",
    "approval"
   ],
   "additionalProperties": false
  }
 }
}
