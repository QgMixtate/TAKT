      "days",
      "start_minute",
      "end_minute",
      "warn_percent"
     ],
     "additionalProperties": false
    },
    "policies": {
     "type": "array",
     "minItems": 8,
     "maxItems": 8,
     "items": {
      "type": "object",
      "properties": {
       "kind": {
        "enum": [
         "incident",
         "request"
        ]
       },
       "priority": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4
       },
