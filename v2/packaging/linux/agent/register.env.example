# C52.04: массовая установка агента. Скопируйте в /etc/surveyscan-agent/register.env (root, 0600) до или после
# установки пакета: служба surveyscan-agent-register зарегистрирует агент один раз и удалит этот файл.
COLLECTOR_URL=https://collector.example:8443
CENTER_FINGERPRINT=<отпечаток центра из Web>
REG_CODE=<код регистрации из Web>
