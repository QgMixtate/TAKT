# C52.04: массовая установка collector. Скопируйте в /etc/surveyscan-collector/register.env (root, 0600) до или
# после установки пакета: служба surveyscan-collector-register зарегистрирует collector один раз и удалит этот файл.
CENTER_URL=https://center.example
CENTER_FINGERPRINT=<отпечаток центра из Web>
REG_CODE=<код регистрации из Web>
LISTEN=0.0.0.0:8443
